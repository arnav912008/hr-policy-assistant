# The app reads these from the environment (export them, or set them in your service manager).
# Nothing here is required; the defaults are shown.

# Where auth.db and employee_dbs/ are stored (default: current folder)
HR_DATA_DIR=.

# Sign users out after this many idle minutes / total hours
HR_IDLE_TIMEOUT_MIN=30
HR_SESSION_MAX_HOURS=8

# Set to 1 to load the Figtree font from Google Fonts (sends visitor IPs to Google).
# Default is the system font, which makes no external requests.
HR_ALLOW_EXTERNAL_FONTS=0

# Demo data: on an empty database the app creates 30 fictional employees. Set to 0 for a real company.
HR_SEED_DEMO=1

# Yearly leave days per person when no individual entitlement has been imported
HR_DEFAULT_ALLOTMENT=annual=18,sick=10,casual=6
